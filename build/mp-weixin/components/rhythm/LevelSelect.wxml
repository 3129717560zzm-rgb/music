<view class="level-select data-v-410ca20d"><button class="back-btn data-v-410ca20d" bindtap="{{a}}"> ← 返回世界地图 </button><view wx:if="{{b}}" class="world-header data-v-410ca20d"><view class="world-icon data-v-410ca20d">{{c}}</view><view class="world-info data-v-410ca20d"><view class="world-name data-v-410ca20d">{{d}}</view><view class="world-desc data-v-410ca20d">{{e}}</view></view></view><view class="levels-grid data-v-410ca20d"><button wx:for="{{f}}" wx:for-item="level" wx:key="m" disabled="{{level.n}}" class="{{['level-card', 'data-v-410ca20d', level.o]}}" bindtap="{{level.p}}"><view class="level-number data-v-410ca20d">{{level.a}}</view><view wx:if="{{level.b}}" class="level-lock data-v-410ca20d"> 🔒 </view><view wx:else class="level-stars data-v-410ca20d">{{level.c}}</view><view class="level-name data-v-410ca20d">{{level.d}}</view><view wx:if="{{level.e}}" class="boss-badge data-v-410ca20d"> BOSS </view><view class="level-tooltip data-v-410ca20d"><view class="tooltip-title data-v-410ca20d">{{level.f}}</view><view class="tooltip-desc data-v-410ca20d">{{level.g}}</view><view class="tooltip-info data-v-410ca20d"><label class="data-v-410ca20d">推荐 {{level.h}} BPM</label><label class="data-v-410ca20d">{{level.i}}</label></view><view wx:if="{{level.j}}" class="tooltip-best data-v-410ca20d"> 最佳: {{level.k}}% @ {{level.l}} BPM </view></view></button></view><view class="level-overview data-v-410ca20d"><view class="overview-item data-v-410ca20d"><label class="overview-label data-v-410ca20d">已完成</label><label class="overview-value data-v-410ca20d">{{g}} / {{h}}</label></view><view class="overview-item data-v-410ca20d"><label class="overview-label data-v-410ca20d">星星</label><label class="overview-value stars data-v-410ca20d">{{i}} / {{j}} ⭐ </label></view></view></view>